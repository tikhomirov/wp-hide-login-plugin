{
  "name": "tikhomirov/wp-hide-login-plugin",
  "description": "Плагин безопасности для замены стандартного URL входа `wp-login.php` на пользовательский slug и защиты от сканирования админки.",
  "version": "1.0.1",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Aleksei Tikhomirov",
      "email": "alex@rwsite.ru",
      "homepage": "https://rwsite.ru"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "files": [
      "inc/login-page-guard.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "hide_login\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
}